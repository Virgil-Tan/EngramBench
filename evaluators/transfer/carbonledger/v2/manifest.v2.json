  "hardCaps": [
    {
      "id": "BUILD_MIGRATION_OR_BOOT",
      "cap": 25,
      "publicInvariant": "Clean build, migration, API, Worker, Dispatcher, and production UI boot must succeed."
    },
    {
      "id": "LOT_CONSERVATION_OR_ATOMIC_REJECTION",
      "cap": 35,
      "publicInvariant": "Every Credit Lot conserves issued grams and every rejected Retirement has zero partial effect."
    },
    {
      "id": "DURABLE_IDEMPOTENCY",
      "cap": 30,
      "publicInvariant": "Unknown outcomes and retries must replay one durable Retirement result."
    },
    {
      "id": "EVENT_ATOMICITY_OR_IDENTITY",
      "cap": 40,
      "publicInvariant": "Business state and Registry Events commit together and retries preserve event identity and body."
    },
    {
      "id": "STALE_WORK_OR_LOST_WORK",
      "cap": 40,
      "publicInvariant": "Pending Work remains recoverable and expired owners cannot commit."
    },
    {
      "id": "SPLIT_ATOMICITY_OR_CERTIFICATE",
      "cap": 35,
      "publicInvariant": "Split allocation, release, retirement, and Certificate publication are all-or-nothing."
    },
    {
      "id": "MIGRATION_COMPATIBILITY",
      "cap": 35,
      "publicInvariant": "Migration preserves V1 history, replay bodies, Certificate bytes, Work, Events, and clients."
    }
  ],
  "specGaps": [
    {
      "id": "SPEC-GAP-01",
      "summary": "The Manager publishes no new split-retirement Event type or payload; no evaluator assertion invents one."
    },
    {
      "id": "SPEC-GAP-02",
      "summary": "The allocations collection publishes no pagination contract; the evaluator asserts only the complete ordered items array."
    }
