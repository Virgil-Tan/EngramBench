  "hardCaps": [
    {
      "id": "CLEAN_BUILD_MIGRATION_BOOT",
      "cap": 25,
      "publicInvariant": "The published install, migration, build and production boot path must complete non-interactively and leave no owned process behind."
    },
    {
      "id": "RATING_CONSERVATION",
      "cap": 35,
      "publicInvariant": "Every immutable Usage Event and accepted Correction contributes exactly once using the source occurredAt Rate Plan and safe integer arithmetic."
    },
    {
      "id": "CORRECTION_REVISION_CORRECTNESS",
      "cap": 35,
      "publicInvariant": "Correction batches are atomic, preserve safe non-negative quantities and serialize each finalized Statement into one continuous Revision chain."
    },
    {
      "id": "IDEMPOTENCY_CORRECTNESS",
      "cap": 30,
      "publicInvariant": "Unknown and concurrent retries preserve one saved response and one business Work and Event effect."
    },
    {
      "id": "EVENT_TRANSACTIONALITY",
      "cap": 40,
      "publicInvariant": "Successful transitions commit exactly one stable Domain Event with business state, while rolled-back transitions commit none."
    },
    {
      "id": "STALE_WORK_OR_LOST_WORK",
      "cap": 40,
      "publicInvariant": "Lease recovery retains all Rating Work and stale owners cannot commit a second or partial Statement effect."
    },
    {
      "id": "MIGRATION_COMPATIBILITY",
      "cap": 35,
      "publicInvariant": "V1 identity replay Work Event Watermark and Statement history survive FINAL migration unchanged."
    }
  ],
