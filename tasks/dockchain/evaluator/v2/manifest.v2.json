  "hardCaps": [
    {
      "id": "PRODUCTION_BOOT",
      "cap": 25,
      "publicInvariant": "The clean production stack migrates builds boots and terminates through the published commands."
    },
    {
      "id": "BUNDLE_CONSERVATION",
      "cap": 35,
      "publicInvariant": "Berth Tug and Yard allocations are one atomic complete bundle and never overlap or oversubscribe."
    },
    {
      "id": "IDEMPOTENCY_CORRECTNESS",
      "cap": 30,
      "publicInvariant": "Unknown and concurrent replay preserves one saved response and one Port Call effect."
    },
    {
      "id": "EVENT_TRANSACTIONALITY",
      "cap": 40,
      "publicInvariant": "Every published successful transition commits one stable ordered Event and rejected transitions commit none."
    },
    {
      "id": "STALE_WORK_OR_LOST_WORK",
      "cap": 40,
      "publicInvariant": "Clearance expiry and promotion Work survive process death while stale leases cannot commit."
    },
    {
      "id": "LINKED_MOVEMENT_ATOMICITY",
      "cap": 35,
      "publicInvariant": "A linked Call creates two complete movement bundles atomically and preserves the published aggregate projection."
    },
    {
      "id": "MIGRATION_COMPATIBILITY",
      "cap": 35,
      "publicInvariant": "V1 Calls allocations Clearances replay Work and Events migrate without changed identity or behavior."
    }
  ],
