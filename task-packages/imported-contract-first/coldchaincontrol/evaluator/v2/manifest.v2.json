  "hardCaps": [
    {
      "id": "PRODUCTION_BOOT",
      "cap": 25,
      "publicInvariant": "Clean migration build production API Worker Dispatcher and UI boot through published commands."
    },
    {
      "id": "TENANT_SECRET_AUTHORITY",
      "cap": 25,
      "publicInvariant": "Tenant boundaries and Device credential secrets never leak or authorize a foreign operation."
    },
    {
      "id": "PROJECTION_AUTHORITY",
      "cap": 35,
      "publicInvariant": "Reading identity ordered projection and route ownership remain deterministic and monotonic."
    },
    {
      "id": "IDEMPOTENCY_AUTHORITY",
      "cap": 30,
      "publicInvariant": "Durable replay preserves one saved response and one business effect across processes and restarts."
    },
    {
      "id": "STALE_WORK_AUTHORITY",
      "cap": 35,
      "publicInvariant": "A stale Worker cannot overwrite newer config projection terminal custody or quarantine state."
    },
    {
      "id": "EVENT_DELIVERY_AUTHORITY",
      "cap": 40,
      "publicInvariant": "Committed Events and notifications survive unknown acknowledgements without identity or body drift."
    },
    {
      "id": "CUSTODY_RECALL_AUTHORITY",
      "cap": 35,
      "publicInvariant": "Custody has one Carrier authority and Recall freezes one complete quarantine set atomically."
    },
    {
      "id": "MIGRATION_COMPATIBILITY",
      "cap": 35,
      "publicInvariant": "FINAL migration preserves every V1 identity replay Event Work delivery credential and audit record."
    }
  ],
  "specGaps": [
    {
      "id": "SPEC-GAP-01",
      "summary": "V1 does not publish one exact success status response wrapper or list cursor wire shape."
    },
    {
      "id": "SPEC-GAP-02",
