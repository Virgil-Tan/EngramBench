    },
    {
      "id": "SPEC-GAP-03",
      "summary": "Notification payload rate-limit window and dead-letter trigger details are unpublished."
    },
    {
      "id": "SPEC-GAP-04",
      "summary": "Barrier payload points and release protocol are unpublished; precise stale-owner injection remains unwired."
    }
  ],
