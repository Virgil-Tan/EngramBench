  "hardCaps": [
    {
      "id": "PRODUCTION_BOOT",
      "cap": 25,
      "publicInvariant": "The clean production stack migrates builds boots and terminates through published commands."
    },
    {
      "id": "INCIDENT_TERMINAL_AUTHORITY",
      "cap": 35,
      "publicInvariant": "Active dedup single winner terminal suppression and rejected mutations preserve one Incident authority."
    },
    {
      "id": "IDEMPOTENCY_CORRECTNESS",
      "cap": 30,
      "publicInvariant": "Unknown and concurrent replay preserves one response effect delivery and acknowledgement vote."
    },
    {
      "id": "EVENT_TRANSACTIONALITY",
      "cap": 40,
      "publicInvariant": "Published successful transitions commit one stable ordered Domain Event while rollback commits none."
    },
    {
      "id": "STALE_WORK_OR_LOST_DELIVERY",
      "cap": 40,
      "publicInvariant": "Escalation and expiry Work plus Notification delivery survive process death and stale leases cannot commit."
    },
    {
      "id": "QUORUM_AUTHORITY",
      "cap": 35,
      "publicInvariant": "Distinct delivered responders form one immutable quorum and at most one Step wins acknowledgement."
    },
    {
      "id": "MIGRATION_COMPATIBILITY",
      "cap": 35,
      "publicInvariant": "V1 acknowledgements delivery replay Work Events and client behavior migrate without identity change."
    }
  ],
