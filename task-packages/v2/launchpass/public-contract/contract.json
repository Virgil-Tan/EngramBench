{
  "taskId": "launchpass",
  "title": "LaunchPass",
  "environmentVariables": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "PORT",
    "ADMIN_TOKEN",
    "HOLD_TTL_SECONDS",
    "WAITLIST_HOLD_TTL_SECONDS"
  ],
  "commands": [
    "npm run db:migrate",
    "npm run seed -- --file <path>",
    "npm run dev",
    "npm run build",
    "npm start",
    "npm test",
    "npm run test:unit",
    "npm run test:integration",
    "npm run test:e2e",
    "npm run test:concurrency",
    "npm run test:all",
    "npm run test:perf"
  ],
  "seed": {
    "schema": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SeedEvent"
          }
        },
        "customers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Customer"
          }
        },
        "orders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SeedOrder"
          }
        }
      },
      "required": [
        "schemaVersion",
        "events",
        "customers",
        "orders"
      ],
      "additionalProperties": false
    },
    "replay": false,
    "command": [
      "npm",
      "run",
      "seed",
      "--",
      "--file",
      "${SEED_PATH}"
    ],
    "example": {
      "schemaVersion": 1,
      "events": [
        {
          "id": "70000000-0000-4000-8000-000000000011",
          "slug": "public-seed-event",
          "title": "Public Seed Event",
          "startsAt": "2099-01-01T00:00:00.000Z",
          "capacity": 20
        }
      ],
      "customers": [
        {
          "id": "70000000-0000-4000-8000-000000000012",
          "displayName": "Public Customer"
        }
      ],
      "orders": [
        {
          "id": "70000000-0000-4000-8000-000000000013",
          "eventId": "70000000-0000-4000-8000-000000000011",
          "customerId": "70000000-0000-4000-8000-000000000012",
          "quantity": 2,
          "confirmedAt": "2026-09-07T00:00:00.000Z"
        }
      ]
    }
  },
  "schemas": {
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "message"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "code",
            "message",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "Health": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ok"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "Event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "slug": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 120
        },
        "startsAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "availableCapacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "id",
        "slug",
        "title",
        "startsAt",
        "capacity",
        "availableCapacity",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "Customer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "displayName"
      ],
      "additionalProperties": false
    },
    "Hold": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "eventId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "customerId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "CONFIRMED",
            "RELEASED",
            "EXPIRED"
          ]
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "id",
        "eventId",
        "customerId",
        "quantity",
        "status",
        "expiresAt",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "Order": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "eventId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "customerId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "holdId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "confirmedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "id",
        "eventId",
        "customerId",
        "holdId",
        "quantity",
        "confirmedAt"
      ],
      "additionalProperties": false
    },
    "WaitlistEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "eventId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "customerId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "status": {
          "type": "string",
          "enum": [
            "WAITING",
            "PROMOTED",
            "WITHDRAWN"
          ]
        },
        "position": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "holdId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "eventId",
        "customerId",
        "quantity",
        "status",
        "position",
        "joinedAt",
        "holdId"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "WAITING"
              }
            }
          },
          "then": {
            "properties": {
              "position": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "holdId": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "PROMOTED"
              }
            }
          },
          "then": {
            "properties": {
              "position": {
                "type": "null"
              },
              "holdId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "WITHDRAWN"
              }
            }
          },
          "then": {
            "properties": {
              "position": {
                "type": "null"
              },
              "holdId": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "SeedEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "slug": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 120
        },
        "startsAt": {
          "type": "string",
          "format": "date-time"
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "id",
        "slug",
        "title",
        "startsAt",
        "capacity"
      ],
      "additionalProperties": false
    },
    "SeedOrder": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "eventId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "customerId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "confirmedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "eventId",
        "customerId",
        "quantity",
        "confirmedAt"
      ],
      "additionalProperties": false
    },
    "Seed": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SeedEvent"
          }
        },
        "customers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Customer"
          }
        },
        "orders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SeedOrder"
          }
        }
      },
      "required": [
        "schemaVersion",
        "events",
        "customers",
        "orders"
      ],
      "additionalProperties": false
    },
    "VerificationSnapshot": {
      "type": "object",
      "properties": {
        "asOf": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "resources": {
          "type": "object",
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Event"
              }
            },
            "customers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Customer"
              }
            },
            "holds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Hold"
              }
            },
            "orders": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Order"
              }
            },
            "waitlistEntries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/WaitlistEntry"
              }
            }
          },
          "required": [
            "events",
            "customers",
            "holds",
            "orders",
            "waitlistEntries"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "asOf",
        "resources"
      ],
      "additionalProperties": false
    }
  },
  "operations": [
    {
      "id": "openapi",
      "method": "GET",
      "path": "/openapi.json",
      "status": 200,
      "source": "docs/frontal-legacy/README.md#http-and-openapi-31",
      "response": {
        "type": "object",
        "required": [
          "openapi",
          "info",
          "paths"
        ],
        "properties": {
          "openapi": {
            "type": "string",
            "pattern": "^3\\.1\\."
          },
          "info": {
            "type": "object"
          },
          "paths": {
            "type": "object"
          },
          "components": {
            "type": "object"
          }
        }
      },
      "requestBody": "none",
      "parameters": [],
      "example": {}
    },
    {
      "id": "production-ui",
      "method": "GET",
      "path": "/",
      "status": 200,
      "source": "docs/frontal-legacy/README.md#real-ui",
      "response": {
        "type": "string",
        "minLength": 1
      },
      "requestBody": "none",
      "parameters": [],
      "example": {}
    },
    {
      "id": "health",
      "method": "GET",
      "path": "/api/health",
      "status": 200,
      "source": "docs/frontal-legacy/README.md#http-and-openapi-31",
      "response": {
        "$ref": "#/$defs/Health"
      },
      "requestBody": "none",
      "parameters": [],
      "example": {}
    },
    {
      "id": "create-event",
      "method": "POST",
      "path": "/api/admin/events",
      "status": 201,
      "source": "docs/frontal-legacy/README.md#http-and-openapi-31",
      "response": {
        "type": "object",
        "properties": {
          "event": {
            "$ref": "#/$defs/Event"
          }
        },
        "required": [
          "event"
        ],
        "additionalProperties": false
      },
      "request": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 120
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          }
        },
        "required": [
          "slug",
          "title",
          "startsAt",
          "capacity"
        ],
        "additionalProperties": false
      },
      "parameters": [
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "pattern": "^[\\x20-\\x7e]+$"
          }
        },
        {
          "name": "Authorization",
          "in": "header",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^Bearer .+$"
          }
        }
      ],
      "example": {
        "body": {
          "slug": "independent-v2-event",
          "title": "Independent V2 Event",
          "startsAt": "2099-01-01T00:00:00.000Z",
          "capacity": 24
        },
        "headers": {
          "Idempotency-Key": "v2-public-create-event",
          "Authorization": "Bearer ${ADMIN_TOKEN}"
        }
      }
    },
    {
      "id": "list-events",
      "method": "GET",
      "path": "/api/events",
      "status": 200,
      "source": "docs/frontal-legacy/README.md#http-and-openapi-31",
      "response": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Event"
            }
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "requestBody": "none",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        {
          "name": "q",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ],
      "example": {
        "query": {
          "limit": 20,
          "q": "public"
        }
      }
    },
    {
      "id": "read-event",
      "method": "GET",
      "path": "/api/events/:eventId",
      "status": 200,
      "source": "V2 public wire clarification (contract notes)",
      "response": {
        "type": "object",
        "properties": {
          "event": {
            "$ref": "#/$defs/Event"
          }
        },
        "required": [
          "event"
        ],
        "additionalProperties": false
      },
      "requestBody": "none",
      "parameters": [
        {
          "name": "eventId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      ],
      "example": {
        "params": {
          "eventId": "70000000-0000-4000-8000-000000000011"
        }
      }
    },
    {
      "id": "create-hold",
      "method": "POST",
      "path": "/api/holds",
      "status": 201,
      "source": "docs/frontal-legacy/README.md#http-and-openapi-31",
      "response": {
        "type": "object",
        "properties": {
          "hold": {
            "$ref": "#/$defs/Hold"
          }
        },
        "required": [
          "hold"
        ],
        "additionalProperties": false
      },
      "request": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "customerId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        },
        "required": [
          "eventId",
          "customerId",
          "quantity"
        ],
        "additionalProperties": false
      },
      "parameters": [
        {
          "name": "Idempotency-Key",
          "in": "header",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "pattern": "^[\\x20-\\x7e]+$"
          }
        }
      ],
      "example": {
        "body": {
          "eventId": "70000000-0000-4000-8000-000000000011",
          "customerId": "70000000-0000-4000-8000-000000000012",
