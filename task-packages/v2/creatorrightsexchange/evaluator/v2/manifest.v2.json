  "hardCaps": [
    {
      "id": "PRODUCTION_BOOT",
      "cap": 25,
      "publicInvariant": "The clean migration build API Worker Dispatcher and production UI must boot through published commands."
    },
    {
      "id": "MEDIA_LINEAGE_ATOMICITY",
      "cap": 35,
      "publicInvariant": "Accepted bytes digest chunk manifest scan rendition and immutable Edition lineage must remain one atomic authority."
    },
    {
      "id": "DURABLE_REPLAY",
      "cap": 30,
      "publicInvariant": "Concurrent unknown-response and restart replay must not create a second commercial fact or media object."
    },
    {
      "id": "STALE_WORK_FENCING",
      "cap": 35,
      "publicInvariant": "Pending Work survives process death and stale owners cannot publish scan rendition License close or delivery results."
    },
    {
      "id": "LICENSE_AUTHORITY_ATOMICITY",
      "cap": 30,
      "publicInvariant": "License Grant balanced posting and entitlement authority commit atomically and a committed fence never permits access."
    },
    {
      "id": "ROYALTY_IMMUTABILITY",
      "cap": 35,
      "publicInvariant": "Royalty postings remain balanced and CLOSED period history and digest are immutable."
    },
    {
      "id": "EVENT_NOTIFICATION_DELIVERY",
      "cap": 40,
      "publicInvariant": "Events and Notifications are transactional ordered and never lost while delivery retries preserve identity and bytes."
    },
    {
      "id": "HOLD_ADJUSTMENT_AUTHORITY",
      "cap": 35,
      "publicInvariant": "An active Hold cannot coexist with allowed authority and an adjustment cannot rewrite its original posting."
    },
    {
      "id": "MIGRATION_COMPATIBILITY",
      "cap": 35,
      "publicInvariant": "V1 media replay identity Work Event entitlement and settled royalty state survive the FINAL migration unchanged."
    }
  ],
  "specGaps": [
    {
      "id": "SPEC-GAP-01",
      "summary": "Asset creation and public resource shape are not fully published; opaque IDs must be discovered only through public responses."
    },
    {
      "id": "SPEC-GAP-02",
      "summary": "ProviderEvent does not publish a sequence field; tests enforce authority monotonicity without inventing sequence ordering."
    },
    {
      "id": "SPEC-GAP-03",
      "summary": "Adjustment RoyaltyEntry wire fields do not publish a new sourceType; tests verify public posting semantics without inventing one."
    }
  ],
