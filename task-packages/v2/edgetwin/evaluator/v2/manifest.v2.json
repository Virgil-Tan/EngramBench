  "hardCaps": [
    {
      "id": "VERSION_REGRESSION",
      "cap": 35,
      "publicInvariant": "Desired and reported versions never regress, skip or apply the same authority transition twice."
    },
    {
      "id": "EXPIRED_DELIVERY",
      "cap": 35,
      "publicInvariant": "A committed expiry or cancellation fences every poll and stale worker from later delivery."
    },
    {
      "id": "RECEIPT_DUPLICATE_EFFECT",
      "cap": 35,
      "publicInvariant": "Receipt identities are immutable and one reported base advances at most once."
    },
    {
      "id": "FALSE_FIRMWARE_SUCCESS",
      "cap": 35,
      "publicInvariant": "Only an acknowledgement proving the frozen target firmware digest may make an upgrade target successful."
    },
    {
      "id": "WAVE_AUTHORITY_OR_ROLLBACK_DRIFT",
      "cap": 35,
      "publicInvariant": "Wave membership, one-running authority and frozen prior-firmware compensation do not drift."
    },
    {
      "id": "DURABLE_IDEMPOTENCY",
      "cap": 30,
      "publicInvariant": "Unknown outcomes and concurrent replay cannot create a second device-control effect."
    },
    {
      "id": "STALE_WORK_COMMIT",
      "cap": 40,
      "publicInvariant": "A stale Work owner cannot commit and recoverable Work is never stranded."
    },
    {
      "id": "MIGRATION_IDENTITY_REWRITE",
      "cap": 35,
      "publicInvariant": "Migration preserves V1 identities, receipt history, events, Work and replay responses."
    }
  ],
