{
  "name": "frontal-v2-carbonledger",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && node dist/lifecycle.js build",
    "db:migrate": "node dist/lifecycle.js db:migrate",
    "db:seed": "node contract/seed.mjs",
    "start:api": "node contract/server.mjs",
    "start:worker": "node dist/lifecycle.js start:worker",
    "start:dispatcher": "node dist/lifecycle.js start:dispatcher",
    "test:public-contract": "node contract/check.mjs --live",
    "check:contract-source": "node contract/check.mjs",
    "test:unit": "node dist/lifecycle.js test:unit",
    "test:integration": "node dist/lifecycle.js test:integration",
    "test:e2e": "node dist/lifecycle.js test:e2e",
    "test:concurrency": "node dist/lifecycle.js test:concurrency",
    "test:recovery": "node dist/lifecycle.js test:recovery",
    "test:perf": "node dist/lifecycle.js test:perf",
    "test:all": "node dist/lifecycle.js test:all",
    "dev": "node dist/lifecycle.js dev"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.3"
  }
}
