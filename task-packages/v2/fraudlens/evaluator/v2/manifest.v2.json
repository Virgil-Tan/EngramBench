  "hardCaps": [
    {
      "id": "HISTORY_IMMUTABILITY",
      "cap": 30,
      "publicInvariant": "Historical Assessments, RuleHits, decisions and Audit entries are immutable."
    },
    {
      "id": "REVIEW_TERMINAL",
      "cap": 30,
      "publicInvariant": "One ReviewCase has at most one fenced terminal decision."
    },
    {
      "id": "CORRECTION_UNIQUENESS",
      "cap": 30,
      "publicInvariant": "One Remediation Run and Assessment pair has at most one append-only correction."
    },
    {
      "id": "TENANT_ISOLATION",
      "cap": 30,
      "publicInvariant": "Tenant risk, review and audit state never crosses tenant boundaries."
    },
    {
      "id": "IDENTITY_ATOMICITY",
      "cap": 30,
      "publicInvariant": "Request replay and external event identity each create at most one atomic effect."
    },
    {
      "id": "VERSION_AUTHORITY",
      "cap": 30,
      "publicInvariant": "Every Assessment freezes the active RuleVersion at its acceptance boundary."
    },
    {
      "id": "WORK_FENCE",
      "cap": 30,
      "publicInvariant": "Expired Work owners cannot commit and every durable Work reaches one terminal effect."
    },
    {
      "id": "MIGRATION_IDENTITY",
      "cap": 30,
      "publicInvariant": "Compatible migration preserves all V1 identities, responses, Work, Events and audit history."
    }
  ],
