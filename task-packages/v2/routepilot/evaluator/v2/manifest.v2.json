  "hardCaps": [
    {
      "id": "ROUTE_AUTHORITY",
      "cap": 35,
      "publicInvariant": "Route precedence, canary identity, rate and circuit decisions use the one frozen release observed by each request."
    },
    {
      "id": "RELEASE_ATOMICITY",
      "cap": 35,
      "publicInvariant": "Activation and rollback expose one complete immutable release and never a mixed route set."
    },
    {
      "id": "RATE_CIRCUIT_CONSERVATION",
      "cap": 35,
      "publicInvariant": "Database-authoritative rate and circuit windows never overspend tokens or probes across processes."
    },
    {
      "id": "IDEMPOTENCY_CORRECTNESS",
      "cap": 30,
      "publicInvariant": "Concurrent and unknown-response replay returns one saved response and creates one logical upstream and release effect."
    },
    {
      "id": "STALE_WORK_OR_LOST_WORK",
      "cap": 40,
      "publicInvariant": "Expired owners cannot commit stale release or rollout authority and every committed Work item remains recoverable."
    },
    {
      "id": "MIGRATION_COMPATIBILITY",
      "cap": 35,
      "publicInvariant": "Migration preserves every V1 identity and replay while creating one deterministic GLOBAL rollout per tenant."
    }
  ],
